{
  "name": "@_linked/schema",
  "displayName": "Schema",
  "license": "UNLICENSED",
  "version": "1.0.8",
  "linkedPackage": true,
  "author": {
    "name": "Valentine Wilson",
    "url": "https://github.com/DiggidyDev",
    "email": "valentinewilson@gmail.com"
  },
  "main": "lib/cjs/index.js",
  "types": "dist/lincd-schema.d.ts",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "rimraf ./lib && yarn build-esm && yarn build-cjs && yarn copy-to-lib && yarn dual-package",
    "build-esm": "echo \"compiling ESM\" && rimraf ./lib/esm && yarn tsc -p tsconfig-esm.json",
    "build-cjs": "echo \"compiling CJS\" && rimraf ./lib/cjs && yarn tsc -p tsconfig-cjs.json",
    "copy-to-lib": "echo 'copying CSS + JSON assets to lib folder' && yarn copyfiles -u 1 'src/**/*.css' 'src/**/*.json' lib/esm && yarn copyfiles -u 1 'src/**/*.css' 'src/**/*.json' lib/cjs",
    "dual-package": "echo 'adding package.json to each lib folder for dual output support' && yarn tsconfig-to-dual-package ./tsconfig-cjs.json ./tsconfig-esm.json"
  },
  "dependencies": {
    "@_linked/core": "^2.0.1",
    "@_linked/primitives": "~1.0",
    "@_linked/react": "^1.1.0",
    "@_linked/server-utils": "~1.0",
    "@_linked/xsd": "~1.0",
    "formidable": "^3.5.4",
    "lincd-mui-base": "~1.0",
    "prism-react-renderer": "^2.4.1",
    "typescript": "^5.7.3",
    "usehooks-ts": "^2.9.1"
  },
  "devDependencies": {
    "@_linked/cli": "^1.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/formidable": "^3.4.5",
    "prism-react-renderer": "^2.4.1",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript-plugin-css-modules": "^5.1.0",
    "rimraf": "^5.0.7",
    "copyfiles": "^2.4.1"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
